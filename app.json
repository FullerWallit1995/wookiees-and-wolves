{
  "expo": {
    "name": "Wookiees & Wolves",
    "slug": "wookiees-and-wolves",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/Moonlit Wookiee Howl.png",
    "scheme": "wookieesandwolves",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/Moonlit Wookiee Howl.png",
      "bundleIdentifier": "com.wookieesandwolves.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Wookiees & Wolves uses your photo library so you can choose a profile picture.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#07111F",
          "image": "./assets/wookiees-wolves-logo.png",
          "imageWidth": 180
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Wookiees & Wolves uses your photo library so you can choose a profile picture.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d80cb809-a5d0-4e45-ac94-c10501a545e0"
      }
    },
    "owner": "wookieesandwolves"
  }
}
